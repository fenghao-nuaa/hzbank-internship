# Standalone short-term-memory data directory.
SHORT_TERM_MEMORY_HOME=~/.dream

# Optional: path to the .env file the CLI loads (default: ./.env in the working
# directory). Process environment always takes priority over file values.
# SHORT_TERM_MEMORY_ENV_FILE=/abs/path/to/.env

# Explicit runtime mode. Production requires both service URL and scope secret.
SHORT_TERM_MEMORY_ENV=development
SHORT_TERM_MEMORY_SCOPE_SECRET=replace-with-a-production-secret

# Redis Session Context.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SESSION_TTL_SECONDS=43200
REDIS_HISTORY_TURNS=10
REDIS_RETAIN_RATIO=0.25
CONTEXT_WINDOW_TOKENS=128000

# DREAM decides when to invoke Headroom; any threshold may trigger compression.
HEADROOM_TRIGGER_RATIO=0.65
HEADROOM_MAX_MESSAGES=100
HEADROOM_MAX_SESSION_SECONDS=14400

# Replaceable official Headroom HTTP service.
HEADROOM_SERVICE_URL=http://127.0.0.1:8787
HEADROOM_SERVICE_TIMEOUT_SECONDS=300
HEADROOM_COMPRESSION_MODEL=deepseek-v4-flash
HEADROOM_CCR_TTL_SECONDS=43200
HEADROOM_CCR_REFRESH_SECONDS=3600
HEADROOM_MAX_COMPRESSION_SEGMENTS=8
HEADROOM_COMPRESSION_WORKERS=8
HEADROOM_QUEUE_CAPACITY=10000
MEMORY_WORKER_SHUTDOWN_GRACE_SECONDS=30

# HTTP memory service. The API token is intentionally blank for development.
MEMORY_API_HOST=127.0.0.1
MEMORY_API_PORT=8080
MEMORY_API_WORKERS=4
MEMORY_API_CONCURRENCY_LIMIT=100
MEMORY_API_REDIS_POOL_SIZE=200
MEMORY_API_MAX_BODY_BYTES=10485760
MEMORY_API_REQUEST_TIMEOUT_SECONDS=10
MEMORY_WRITE_MAX_BATCH_EVENTS=100
MEMORY_API_AUTH_TOKEN=

# Durable original-event journals.
JOURNAL_RETENTION_DAYS=30

# Public defaults only. Keep DEEPSEEK_API_KEY in the chat caller's environment.
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Claude-style recursive activity compaction. The deployment injects the same
# provider used by the Agent as a separate compact request adapter.
CONTINUITY_COMPACTION_ENABLED=true
CONTINUITY_COMPACTION_MODEL=deepseek-v4-flash
COMPACTION_PREPARE_TIMEOUT_SECONDS=300

# Portable Claude time-based L1. Disabled by default, matching Claude config.
TIME_BASED_MICROCOMPACT_ENABLED=false
TIME_BASED_MICROCOMPACT_GAP_MINUTES=60
TIME_BASED_MICROCOMPACT_KEEP_RECENT=5
